# ============================================================
# KeywordScout — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Never expose publicly

# ── Stripe ───────────────────────────────────────────────────
# Found in: Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...                   # From: stripe listen --forward-to localhost

# Stripe Price IDs (create products + prices in Stripe Dashboard)
STRIPE_PRO_PRICE_ID=price_...
STRIPE_BUSINESS_PRICE_ID=price_...

# ── AI (Claude) ──────────────────────────────────────────────
# Found in: https://console.anthropic.com → API Keys
# Used for: multilingual title generation, content angles, intent detection
# Without this key the app uses English template fallbacks
ANTHROPIC_API_KEY=sk-ant-...

# ── SERP Providers (configure at least one) ──────────────────

# SerpApi — https://serpapi.com
SERPAPI_API_KEY=

# Serper.dev — https://serper.dev
SERPER_API_KEY=

# DataForSEO — https://dataforseo.com
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
